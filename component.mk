# ESP32 Hardware PWM Component for Sming Framework

COMPONENT_SRCDIRS := src
COMPONENT_INCDIRS := src/include

# ESP32 specific component - currently keeps esp8266 from building -
COMPONENT_SOC := esp32*

# Required for C++ features
# COMPONENT_CXXFLAGS += -std=c++17

# Debug level for Esp32HardwarePwm (0=off, 1=errors, 2=+info, 3=full). Override in your app Makefile.
HW_PWM_DEBUG ?= 0
COMPONENT_CXXFLAGS += -DHW_PWM_DEBUG=$(HW_PWM_DEBUG)

HWPWM_TIMING_TRACE ?= 0
COMPONENT_VARS += HWPWM_TIMING_TRACE
ifeq ($(HWPWM_TIMING_TRACE),1)
COMPONENT_CXXFLAGS += -DHWPWM_TIMING_TRACE
endif

# ---------------------------------------------------------------------------
# SOC-specific calibration table (generated by TimingTest_HwPWM)
#
# If src/calibration/HwPwmCalib_<SMING_SOC>.h exists the library compiles
# it in. The worker architecture only auto-installs tables containing
# HWPWM_CALIB_WORKER; legacy Sming-dispatch measurements must be regenerated.
#
# To generate the file:
#   1. Build and flash TimingTest_HwPWM (no calibration file present yet)
#   2. Open serial monitor and capture the block between
#      "---- copy from here ----" and "---- copy to here ----"
#   3. Save it as  src/calibration/HwPwmCalib_$(SMING_SOC).h
#   4. Rebuild (this rule will detect it automatically)
#   5. Re-run TimingTest_HwPWM to validate the corrections
# ---------------------------------------------------------------------------
HWPWM_CALIB_HDR := $(COMPONENT_PATH)/src/calibration/HwPwmCalib_$(SMING_SOC).h
ifneq ($(wildcard $(HWPWM_CALIB_HDR)),)
  COMPONENT_CXXFLAGS += -DHWPWM_HAS_SOC_CALIB
  COMPONENT_CXXFLAGS += -DHWPWM_SOC_CALIB_HEADER='"HwPwmCalib_$(SMING_SOC).h"'
  COMPONENT_INCDIRS  += src/calibration
  $(info Esp32HardwarePwm: inspecting SOC calibration table $(HWPWM_CALIB_HDR) (worker marker required))
endif

