{
  "name": "Esp32HardwarePwm",
  "version": "1.0.1",
  "description": "ESP32 LEDC PWM wrapper for Sming Framework with phase shifting, spread spectrum capability and hardware fade support",
  "keywords": [
    "ESP32",
    "PWM", 
    "LEDC",
    "hardware",
    "fade",
    "phase-shift",
    "sming",
    "esp-idf"
  ],
  "author": "Peter Jakobs <pjakobs@mobileme.de>",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/pljakobs/Esp32HardwarePwm.git"
  },
  "dependencies": {
    "SmingCore": "*"
  },
  "frameworks": [
    "sming"
  ],
  "platforms": [
    "esp32"
  ],
  "arch": [
    "esp32"
  ],
  "targets": {
    "esp32": {
      "vendor": "espressif"
    }
  },
  "build": {
    "flags": [
      "-std=c++17"
    ],
    "cpp_std": "c++17"
  }
}
